---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const REPO = "https://github.com/ilfroloff/snapback";

const features = [
  { flag: "--one-board", desc: "Past sessions and live background agents in one place that stays open and updates as they write: this folder, the repo's worktrees (-p), or every repo (-a)." },
  { flag: "--search", desc: "Search inside the whole conversation, not only names. Words have to appear near each other, and the preview jumps to the line." },
  { flag: "--everything", desc: "Every transcript in the store, including claude -p, Agent SDK and /loop sessions." },
  { flag: "--tidy", desc: "Hide a session, or delete one — or a whole set of background copies — from disk. Anything still being written is refused." },
  { flag: "--fold", desc: "The look-alike copies a background hand-off leaves behind fold into one (+N) row, with message counts." },
  { flag: "--move", desc: "Move a session — or a whole set of its background copies — to another of the repo's worktrees, main included, without opening it or leaving the board." },
  { flag: "--model", desc: "Pick the model and effort for a single reply, and see which model answered each turn." },
];

const comparison = [
  { aspect: "-p, SDK and /loop sessions", alone: "hidden from the picker", snapback: "shown (--everything)" },
  { aspect: "Background agents", alone: "one at a time", snapback: "all at once, live" },
  { aspect: "Search", alone: "session names", snapback: "inside full transcripts" },
  { aspect: "Act on an agent", alone: "switch between picker and CLI", snapback: "reply, stop, start from one board" },
  { aspect: "Scope", alone: "one project", snapback: "every repo and worktree (-a)" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>snapback — Claude Code session & agent manager for the terminal</title>
  <meta name="description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />

  <link rel="canonical" href="https://www.if-developer.fyi/snapback/" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="snapback" />
  <meta property="og:title" content="snapback — every Claude Code session and agent on one live board" />
  <meta property="og:description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />
  <meta property="og:url" content="https://www.if-developer.fyi/snapback/" />
  <meta property="og:image" content="https://www.if-developer.fyi/snapback/og.png" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="snapback — every Claude Code session and agent on one live board" />
  <meta name="twitter:description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />
  <meta name="twitter:image" content="https://www.if-developer.fyi/snapback/og.png" />

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "snapback",
    "description": "A terminal board for every Claude Code session and running agent — search transcripts, see the sessions the picker hides, reply, stop, or start agents.",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS, Linux",
    "url": "https://www.if-developer.fyi/snapback/",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="bar">
    <a class="lockup" href={base}>
      <img src={`${base}favicon-512.png`} alt="" width="22" height="22" />
      snapback
    </a>
    <a class="gh-link" href={REPO}>github ↗</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">terminal board for claude code</p>
        <h1>Every Claude Code session and agent — one live board</h1>
        <p class="sub">
          Claude Code's picker skips -p, Agent SDK and /loop sessions, and
          running agents scatter across your repos and worktrees. snapback puts
          all of it on one live board — search inside full transcripts, then
          reply, stop, or start an agent without leaving.
        </p>

        <div class="prompt">
          <span class="prompt-sigil">$</span>
          <span class="prompt-cmd">npx snapback-tui install</span
          ><span class="cursor" aria-hidden="true">_</span>
        </div>
        <p class="alt-install">or build from source — see the README</p>

        <a class="cta" href={REPO}>View on GitHub</a>
      </div>

      <div class="demo-frame" role="img" aria-label="snapback terminal demo">
        <div class="demo-titlebar">snapback -a</div>
        <div class="demo-body">
          <img
            src={`${base}demo.gif`}
            alt="snapback demo: a live board of Claude Code sessions and agents"
            onerror="this.closest('.demo-body').classList.add('demo-missing')"
          />
          <p class="demo-fallback">
            drop demo.gif into <code>public/</code> — generated by <code>website/demo/record.sh</code>
          </p>
        </div>
      </div>
    </section>

    <section class="callout">
      <p class="label"># what claude code hides</p>
      <p class="callout-card">
        -p, Agent SDK and /loop sessions never appear in Claude Code's own picker —
        its <a href="https://code.claude.com/docs/en/sessions">docs</a> confirm the
        picker skips them. snapback reads every transcript on disk, including the
        runs the picker hides, and shows them beside your running agents.
      </p>
    </section>

    <section class="features">
      <p class="label"># why snapback</p>
      <dl class="flags">
        <div class="flag-row">
          <dt>See everything, live</dt>
          <dd>Every session and running background agent — this folder, the repo's worktrees (-p), or every repo (-a) — updating as agents write.</dd>
        </div>
        <div class="flag-row">
          <dt>Act without leaving</dt>
          <dd>Reply (Ctrl-R), stop (Ctrl-K), or start a background agent (Ctrl-N), then get straight back to the board.</dd>
        </div>
        <div class="flag-row">
          <dt>Find it by what was said</dt>
          <dd>Search inside full transcripts, not just names; the preview jumps to the hit.</dd>
        </div>
        <div class="flag-row">
          <dt>Keep it tidy</dt>
          <dd>Hide or delete old sessions and folded hand-off copies, with anything still being written refused.</dd>
        </div>
      </dl>
    </section>

    <section class="features">
      <p class="label"># why snapback over Claude Code alone</p>
      <dl class="compare">
        <div class="compare-head">
          <span></span>
          <span>Claude Code alone</span>
          <span>snapback</span>
        </div>
        {comparison.map((row) => (
          <div class="compare-row">
            <dt>{row.aspect}</dt>
            <dd class="alone">{row.alone}</dd>
            <dd class="snap">{row.snapback}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="features">
      <p class="label"># features</p>
      <dl class="flags">
        {features.map((f) => (
          <div class="flag-row">
            <dt>{f.flag}</dt>
            <dd>{f.desc}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <footer>
    <span>Apache-2.0</span>
    <span aria-hidden="true">·</span>
    <a href={REPO}>GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://www.npmjs.com/package/snapback-tui">npm</a>
  </footer>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-raised: #14171c;
    --border: #2d333b;
    --dim: #4a535e;
    --accent: #ffb454;
    --text: #e6e8eb;
    --text-dim: #8b949e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  code {
    font-family: inherit;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.92em;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 24px 0;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .lockup img {
    border-radius: 6px;
    display: block;
  }

  .gh-link {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .gh-link:hover {
    color: var(--text);
  }

  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 64px 0 80px;
  }

  .eyebrow {
    color: var(--dim);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin: 0 0 14px;
  }
  .eyebrow::before {
    content: "# ";
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.15;
    margin: 0 0 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 28px;
  }

  .prompt {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }
  .prompt-sigil {
    color: var(--dim);
  }
  .prompt-cmd {
    white-space: nowrap;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .alt-install {
    color: var(--dim);
    font-size: 0.82rem;
    margin: 10px 0 30px;
  }

  .cta {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .cta:hover {
    opacity: 0.9;
  }

  .demo-frame {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .demo-titlebar {
    padding: 9px 14px;
    font-size: 0.78rem;
    color: var(--dim);
    border-bottom: 1px solid var(--border);
  }
  .demo-body {
    position: relative;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .demo-body img {
    width: 100%;
    display: block;
  }
  .demo-fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 20px;
    color: var(--dim);
    font-size: 0.78rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .demo-body.demo-missing img {
    display: none;
  }
  .demo-body.demo-missing .demo-fallback {
    display: flex;
  }

  .label {
    color: var(--dim);
    font-size: 0.85rem;
    margin: 0 0 18px;
  }

  .features {
    border-top: 1px solid var(--border);
    padding: 56px 0 72px;
  }

  .flags {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .flag-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .flag-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .flag-row dt {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .flag-row dd {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .callout {
    border-top: 1px solid var(--border);
    padding: 56px 0 72px;
  }

  .callout-card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px 24px;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    max-width: 72ch;
  }
  .callout-card a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .compare {
    margin: 0;
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 170px 1fr 1fr;
    gap: 18px;
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .compare-head {
    color: var(--dim);
    font-size: 0.82rem;
    padding-top: 0;
  }
  .compare-row:last-child {
    border-bottom: none;
  }
  .compare-row dt {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .compare-row dd {
    margin: 0;
    font-size: 0.92rem;
  }
  .compare-row dd.alone {
    color: var(--text-dim);
  }
  .compare-row dd.snap {
    color: var(--text);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 28px 24px 40px;
    max-width: 980px;
    margin: 0 auto;
    color: var(--dim);
    font-size: 0.85rem;
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  footer a {
    color: var(--text-dim);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 40px 0 56px;
    }
    .flag-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .compare-head,
    .compare-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .compare-head span:first-child {
      display: none;
    }
  }
</style>
