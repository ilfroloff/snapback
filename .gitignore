# Rust build artifacts for the `snapback` crate.
# Root .gitignore has no `target` rule; this tool-local ignore is the correct scope.
/target

# Cargo.lock is intentionally NOT ignored: this is a binary crate, so the lockfile
# is committed for reproducible builds (reinforces the exact version pins).

# `ai-to-go` artifacts
/docs/plans

# Local `wtp` git-worktree checkouts (`.wtp.yml` sets `base_dir: .agents/worktrees`).
# Scoped to `worktrees/` only: agent definitions elsewhere in `.agents/` stay committable.
/.agents/worktrees/
/.wtp.yml
