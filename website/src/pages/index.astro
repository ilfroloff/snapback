---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const REPO = "https://github.com/ilfroloff/snapback";

const features = [
  { flag: "--one-board", desc: "Past sessions and live background agents in one place that stays open and updates as they write: this folder, the repo's worktrees (-p), or every repo (-a)." },
  { flag: "--search", desc: "Search inside the whole conversation, not only names. Words have to appear near each other, and the preview jumps to the line." },
  { flag: "--everything", desc: "Every transcript in the store, including claude -p, Agent SDK and /loop sessions." },
  { flag: "--tidy", desc: "Hide a session, or delete one — or a whole set of background copies and forks — from disk. Anything still being written is refused." },
  { flag: "--fold", desc: "The look-alike copies a background hand-off leaves behind fold into one (+N) row, with message counts — and forks you make on the board stay under the session they came from, each under its own name." },
  { flag: "--move", desc: "Move a session — or a whole set of its background copies and forks — to another of the repo's worktrees, main included, without opening it or leaving the board." },
  { flag: "--model", desc: "Pick the model and effort for a single reply, and see which model answered each turn." },
];

const comparison = [
  { aspect: "-p, SDK and /loop sessions", alone: "hidden from the picker", snapback: "shown (--everything)" },
  { aspect: "Background agents", alone: "one at a time", snapback: "all at once, live" },
  { aspect: "Search", alone: "session names", snapback: "inside full transcripts" },
  { aspect: "Act on an agent", alone: "switch between picker and CLI", snapback: "reply, stop, start from one board" },
  { aspect: "Scope", alone: "one project", snapback: "every repo and worktree (-a)" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>snapback — Claude Code session & agent manager for the terminal</title>
  <meta name="description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />

  <link rel="canonical" href="https://www.if-developer.fyi/snapback/" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="snapback" />
  <meta property="og:title" content="snapback — every Claude Code session and agent on one live board" />
  <meta property="og:description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />
  <meta property="og:url" content="https://www.if-developer.fyi/snapback/" />
  <meta property="og:image" content="https://www.if-developer.fyi/snapback/og.png" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="snapback — every Claude Code session and agent on one live board" />
  <meta name="twitter:description" content="Manage every Claude Code session and running agent from one terminal board — search transcripts, see the sessions the picker hides, and act without leaving." />
  <meta name="twitter:image" content="https://www.if-developer.fyi/snapback/og.png" />

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "snapback",
    "description": "A terminal board for every Claude Code session and running agent — search transcripts, see the sessions the picker hides, reply, stop, or start agents.",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS, Linux",
    "url": "https://www.if-developer.fyi/snapback/",
    "license": "https://www.apache.org/licenses/LICENSE-2.0",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="bar">
    <a class="lockup" href={base}>
      <img src={`${base}favicon-512.png`} alt="" width="22" height="22" />
      snapback
    </a>
    <a class="gh-link" href={REPO}>github ↗</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">terminal board for claude code</p>
        <h1>Every Claude Code session and agent — one live board</h1>
        <p class="sub">
          Claude Code's picker skips -p, Agent SDK and /loop sessions, and
          running agents scatter across your repos and worktrees. snapback puts
          all of it on one live board — search inside full transcripts, then
          reply, stop, or start an agent without leaving.
        </p>

        <div class="install-tabs" data-install-tabs>
          <div class="install-tablist" role="tablist" aria-label="Installation methods">
            <button class="install-tab active" role="tab" aria-selected="true" aria-controls="panel-npm" id="tab-npm" data-tab="npm" tabindex="0">
              <svg class="install-tab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" fill="#CB3837"/><path d="M7 7h10v10h-3V10H11v7H7V7z" fill="#fff"/></svg>
              <span>npm</span>
            </button>
            <button class="install-tab" role="tab" aria-selected="false" aria-controls="panel-brew" id="tab-brew" data-tab="brew" tabindex="-1">
              <svg class="install-tab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2C10.5 2 9 3 9 5c0 1.5.5 2.5 1 3.5L8 12c-.5 1-1 2-1 3 0 3 2 5 5 5s5-2 5-5c0-1-.5-2-1-3l-2-3.5c.5-1 1-2 1-3.5 0-2-1.5-3-3-3z" fill="#FFB454"/><rect x="10" y="18" width="4" height="3" rx="1" fill="#FFB454"/></svg>
              <span>Homebrew</span>
            </button>
            <button class="install-tab" role="tab" aria-selected="false" aria-controls="panel-curl" id="tab-curl" data-tab="curl" tabindex="-1">
              <svg class="install-tab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="3" stroke="currentColor" stroke-width="2"/><path d="M6 10l3 2-3 2M12 14h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>curl</span>
            </button>
          </div>
          <div class="install-panels">
            <div class="install-panel active" role="tabpanel" id="panel-npm" aria-labelledby="tab-npm" data-panel="npm">
              <div class="install-cmd">
                <span class="prompt-sigil">$</span>
                <code class="install-cmd-text">npx snapback-tui install</code>
                <button class="install-copy" aria-label="Copy command" data-copy="npx snapback-tui install">
                  <svg class="install-copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <span class="install-copy-label">Copy</span>
                </button>
              </div>
            </div>
            <div class="install-panel" role="tabpanel" id="panel-brew" aria-labelledby="tab-brew" data-panel="brew" hidden>
              <div class="install-cmd">
                <span class="prompt-sigil">$</span>
                <code class="install-cmd-text">brew install snapback</code>
                <button class="install-copy" aria-label="Copy command" data-copy="brew install snapback">
                  <svg class="install-copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <span class="install-copy-label">Copy</span>
                </button>
              </div>
            </div>
            <div class="install-panel" role="tabpanel" id="panel-curl" aria-labelledby="tab-curl" data-panel="curl" hidden>
              <div class="install-cmd">
                <span class="prompt-sigil">$</span>
                <code class="install-cmd-text">curl -fsSL https://raw.githubusercontent.com/ilfroloff/snapback/main/scripts/install.sh | sh</code>
                <button class="install-copy" aria-label="Copy command" data-copy="curl -fsSL https://raw.githubusercontent.com/ilfroloff/snapback/main/scripts/install.sh | sh">
                  <svg class="install-copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                  <span class="install-copy-label">Copy</span>
                </button>
              </div>
            </div>
          </div>
        </div>
        <noscript>
          <div class="install-noscript">
            <div class="install-noscript-row"><span>npm</span> <code>npx snapback-tui install</code></div>
            <div class="install-noscript-row"><span>Homebrew</span> <code>brew install snapback</code></div>
            <div class="install-noscript-row"><span>curl</span> <code>curl -fsSL https://raw.githubusercontent.com/ilfroloff/snapback/main/scripts/install.sh | sh</code></div>
          </div>
        </noscript>
        <p class="alt-install">or build from source — see the README</p>

        <a class="cta" href={REPO}>View on GitHub</a>
      </div>

      <div class="demo-frame" role="img" aria-label="snapback terminal demo">
        <div class="demo-titlebar">snapback -a</div>
        <div class="demo-body">
          <img
            src={`${base}demo.gif`}
            alt="snapback demo: a live board of Claude Code sessions and agents"
            onerror="this.closest('.demo-body').classList.add('demo-missing')"
          />
          <p class="demo-fallback">
            drop demo.gif into <code>public/</code> — generated by <code>website/demo/record.sh</code>
          </p>
        </div>
      </div>
    </section>

    <section class="callout">
      <p class="label"># what claude code hides</p>
      <p class="callout-card">
        -p, Agent SDK and /loop sessions never appear in Claude Code's own picker —
        its <a href="https://code.claude.com/docs/en/sessions">docs</a> confirm the
        picker skips them. snapback reads every transcript on disk, including the
        runs the picker hides, and shows them beside your running agents.
      </p>
    </section>

    <section class="features">
      <p class="label"># why snapback</p>
      <dl class="flags">
        <div class="flag-row">
          <dt>See everything, live</dt>
          <dd>Every session and running background agent — this folder, the repo's worktrees (-p), or every repo (-a) — updating as agents write.</dd>
        </div>
        <div class="flag-row">
          <dt>Act without leaving</dt>
          <dd>Reply (Ctrl-R), fork (Ctrl-F), stop (Ctrl-K), or start a background agent (Ctrl-N), then get straight back to the board.</dd>
        </div>
        <div class="flag-row">
          <dt>Find it by what was said</dt>
          <dd>Search inside full transcripts, not just names; the preview jumps to the hit.</dd>
        </div>
        <div class="flag-row">
          <dt>Keep it tidy</dt>
          <dd>Hide or delete old sessions and folded hand-off copies, with anything still being written refused.</dd>
        </div>
      </dl>
    </section>

    <section class="features">
      <p class="label"># why snapback over Claude Code alone</p>
      <dl class="compare">
        <div class="compare-head">
          <span></span>
          <span>Claude Code alone</span>
          <span>snapback</span>
        </div>
        {comparison.map((row) => (
          <div class="compare-row">
            <dt>{row.aspect}</dt>
            <dd class="alone">{row.alone}</dd>
            <dd class="snap">{row.snapback}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="features">
      <p class="label"># features</p>
      <dl class="flags">
        {features.map((f) => (
          <div class="flag-row">
            <dt>{f.flag}</dt>
            <dd>{f.desc}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <footer>
    <span>Apache-2.0</span>
    <span aria-hidden="true">·</span>
    <a href={REPO}>GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://www.npmjs.com/package/snapback-tui">npm</a>
  </footer>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-raised: #14171c;
    --border: #2d333b;
    --dim: #4a535e;
    --accent: #ffb454;
    --text: #e6e8eb;
    --text-dim: #8b949e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  code {
    font-family: inherit;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.92em;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 24px 0;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .lockup img {
    border-radius: 6px;
    display: block;
  }

  .gh-link {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .gh-link:hover {
    color: var(--text);
  }

  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 64px 0 80px;
  }

  .eyebrow {
    color: var(--dim);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin: 0 0 14px;
  }
  .eyebrow::before {
    content: "# ";
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.15;
    margin: 0 0 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 28px;
  }

  .prompt {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }
  .prompt-sigil {
    color: var(--dim);
  }
  .prompt-cmd {
    white-space: nowrap;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .alt-install {
    color: var(--dim);
    font-size: 0.82rem;
    margin: 10px 0 30px;
  }

  /* Tabbed installation UI */
  .install-tabs {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 100%;
  }
  .install-tablist {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }
  .install-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
    margin-bottom: -1px;
  }
  .install-tab:hover {
    color: var(--text);
  }
  .install-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .install-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 4px 4px 0 0;
  }
  .install-tab-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .install-panels {
    position: relative;
  }
  .install-panel {
    display: none;
  }
  .install-panel.active {
    display: block;
  }
  .install-cmd {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    width: 100%;
    overflow-x: auto;
  }
  .install-cmd-text {
    white-space: nowrap;
    flex: 1;
    font-family: inherit;
    background: none;
    border: none;
    padding: 0;
    color: var(--text);
    font-size: inherit;
  }
  .install-copy {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    flex-shrink: 0;
  }
  .install-copy:hover {
    color: var(--text);
    border-color: var(--text-dim);
    background: var(--bg);
  }
  .install-copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .install-copy.copied {
    color: var(--accent);
    border-color: var(--accent);
  }
  .install-copy-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .install-copy-label {
    white-space: nowrap;
  }
  .install-noscript {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.9rem;
  }
  .install-noscript-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .install-noscript-row span {
    color: var(--accent);
    font-weight: 600;
    min-width: 80px;
  }
  .install-noscript-row code {
    font-family: inherit;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 0.88rem;
    word-break: break-all;
  }
  @media (prefers-reduced-motion: reduce) {
    .install-tab,
    .install-copy {
      transition: none;
    }
  }

  .cta {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .cta:hover {
    opacity: 0.9;
  }

  .demo-frame {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .demo-titlebar {
    padding: 9px 14px;
    font-size: 0.78rem;
    color: var(--dim);
    border-bottom: 1px solid var(--border);
  }
  .demo-body {
    position: relative;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .demo-body img {
    width: 100%;
    display: block;
  }
  .demo-fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 20px;
    color: var(--dim);
    font-size: 0.78rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .demo-body.demo-missing img {
    display: none;
  }
  .demo-body.demo-missing .demo-fallback {
    display: flex;
  }

  .label {
    color: var(--dim);
    font-size: 0.85rem;
    margin: 0 0 18px;
  }

  .features {
    border-top: 1px solid var(--border);
    padding: 56px 0 72px;
  }

  .flags {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .flag-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .flag-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .flag-row dt {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .flag-row dd {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .callout {
    border-top: 1px solid var(--border);
    padding: 56px 0 72px;
  }

  .callout-card {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px 24px;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
    max-width: 72ch;
  }
  .callout-card a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .compare {
    margin: 0;
  }
  .compare-head,
  .compare-row {
    display: grid;
    grid-template-columns: 170px 1fr 1fr;
    gap: 18px;
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .compare-head {
    color: var(--dim);
    font-size: 0.82rem;
    padding-top: 0;
  }
  .compare-row:last-child {
    border-bottom: none;
  }
  .compare-row dt {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }
  .compare-row dd {
    margin: 0;
    font-size: 0.92rem;
  }
  .compare-row dd.alone {
    color: var(--text-dim);
  }
  .compare-row dd.snap {
    color: var(--text);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 28px 24px 40px;
    max-width: 980px;
    margin: 0 auto;
    color: var(--dim);
    font-size: 0.85rem;
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  footer a {
    color: var(--text-dim);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 40px 0 56px;
    }
    .flag-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .compare-head,
    .compare-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .compare-head span:first-child {
      display: none;
    }
    .install-tablist {
      flex-direction: column;
      gap: 0;
      border-bottom: none;
    }
    .install-tab {
      border-bottom: none;
      border-left: 2px solid transparent;
      margin-bottom: 0;
      margin-left: -1px;
      padding: 12px 16px;
      width: 100%;
      justify-content: flex-start;
    }
    .install-tab.active {
      border-left-color: var(--accent);
    }
    .install-tab:focus-visible {
      border-radius: 0;
    }
    .install-cmd {
      border-radius: 0 0 8px 8px;
      border-top: none;
      border-left: 1px solid var(--border);
    }
    .install-cmd-text {
      font-size: 0.82rem;
      white-space: normal;
      word-break: break-all;
    }
    .install-noscript-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>

<script>
  (function () {
    const container = document.querySelector("[data-install-tabs]");
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll(".install-tab"));
    const panels = Array.from(container.querySelectorAll(".install-panel"));
    const copyButtons = Array.from(container.querySelectorAll(".install-copy"));

    // Restore last-selected tab from localStorage
    const STORAGE_KEY = "snapback-install-tab";
    let storedTab = null;
    try {
      storedTab = localStorage.getItem(STORAGE_KEY);
    } catch (_) {
      // localStorage unavailable — ignore
    }

    function activateTab(tabName) {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === tabName;
        tab.classList.toggle("active", isActive);
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });
      panels.forEach((panel) => {
        const isActive = panel.dataset.panel === tabName;
        panel.classList.toggle("active", isActive);
        if (isActive) {
          panel.removeAttribute("hidden");
        } else {
          panel.setAttribute("hidden", "");
        }
      });
      try {
        localStorage.setItem(STORAGE_KEY, tabName);
      } catch (_) {
        // localStorage unavailable — ignore
      }
    }

    // Initialize from stored preference or default to npm
    const initialTab = storedTab && tabs.some((t) => t.dataset.tab === storedTab)
      ? storedTab
      : "npm";
    activateTab(initialTab);

    // Tab click handler
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activateTab(tab.dataset.tab);
        tab.focus();
      });
    });

    // Keyboard navigation (arrow keys, Home, End)
    container.querySelector(".install-tablist").addEventListener("keydown", (e) => {
      const currentTab = document.activeElement;
      if (!tabs.includes(currentTab)) return;

      const currentIndex = tabs.indexOf(currentTab);
      let nextIndex = currentIndex;

      switch (e.key) {
        case "ArrowRight":
        case "ArrowDown":
          nextIndex = (currentIndex + 1) % tabs.length;
          e.preventDefault();
          break;
        case "ArrowLeft":
        case "ArrowUp":
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          e.preventDefault();
          break;
        case "Home":
          nextIndex = 0;
          e.preventDefault();
          break;
        case "End":
          nextIndex = tabs.length - 1;
          e.preventDefault();
          break;
        case "Enter":
        case " ":
          activateTab(currentTab.dataset.tab);
          e.preventDefault();
          return;
        default:
          return;
      }

      activateTab(tabs[nextIndex].dataset.tab);
      tabs[nextIndex].focus();
    });

    // Copy button handler
    copyButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const command = btn.dataset.copy;
        if (!command) return;

        const label = btn.querySelector(".install-copy-label");
        const originalLabel = label ? label.textContent : "Copy";

        try {
          await navigator.clipboard.writeText(command);
        } catch (_) {
          // Fallback for older browsers / non-HTTPS
          const textarea = document.createElement("textarea");
          textarea.value = command;
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          try {
            document.execCommand("copy");
          } catch (_) {
            // Copy failed — silently ignore
          }
          document.body.removeChild(textarea);
        }

        btn.classList.add("copied");
        if (label) label.textContent = "Copied!";

        setTimeout(() => {
          btn.classList.remove("copied");
          if (label) label.textContent = originalLabel;
        }, 2000);
      });
    });
  })();
</script>
