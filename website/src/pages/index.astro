---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const REPO = "https://github.com/ilfroloff/snapback";

const features = [
  { flag: "--search", desc: "Search transcripts, not just titles — proximity-matched, live-highlighted." },
  { flag: "--live", desc: "Status badges show which agents are working, idle, or waiting on you." },
  { flag: "--fold", desc: "Look-alike duplicate sessions collapse into one row automatically." },
  { flag: "--fast", desc: "Native Rust binary. No runtime, no Node at run time — instant startup." },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>snapback — every Claude Code session, one list</title>
  <meta name="description" content="A fast terminal UI that finds, searches, and resumes any Claude Code session across every project on your machine." />
  <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="bar">
    <a class="lockup" href={base}>
      <img src={`${base}favicon-512.png`} alt="" width="22" height="22" />
      snapback
    </a>
    <a class="gh-link" href={REPO}>github ↗</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">terminal session manager for claude code</p>
        <h1>Every Claude Code session.<br />One searchable list.</h1>
        <p class="sub">
          snapback finds, searches, and resumes any session across every
          project on your machine — searchable by what was actually said,
          not just the title.
        </p>

        <div class="prompt">
          <span class="prompt-sigil">$</span>
          <span class="prompt-cmd">npx snapback-tui install</span
          ><span class="cursor" aria-hidden="true">_</span>
        </div>
        <p class="alt-install">or build from source — see the README</p>

        <a class="cta" href={REPO}>View on GitHub</a>
      </div>

      <div class="demo-frame" role="img" aria-label="snapback terminal demo">
        <div class="demo-titlebar">snapback -a</div>
        <div class="demo-body">
          <img
            src={`${base}demo.gif`}
            alt="snapback demo: browsing, searching, and resuming Claude Code sessions"
            onerror="this.closest('.demo-body').classList.add('demo-missing')"
          />
          <p class="demo-fallback">
            drop demo.gif into <code>public/</code> — generated by the vhs
            tape in the project README
          </p>
        </div>
      </div>
    </section>

    <section class="why">
      <p class="label"># why</p>
      <p>
        Claude Code's built-in <code>/resume</code> shows the current project,
        newest first, by title. Work across a dozen repos and worktrees, and
        you're back to <code>cd</code>-ing around, guessing which folder held
        the session you actually want.
      </p>
      <p>
        Hand a prompt to a background agent and Claude Code quietly forks the
        session into a new file — same name, same folder, just a new copy.
        snapback notices, and folds the look-alikes back into one row.
      </p>
    </section>

    <section class="features">
      <p class="label"># features</p>
      <dl class="flags">
        {features.map((f) => (
          <div class="flag-row">
            <dt>{f.flag}</dt>
            <dd>{f.desc}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <footer>
    <span>Apache-2.0</span>
    <span aria-hidden="true">·</span>
    <a href={REPO}>GitHub</a>
    <span aria-hidden="true">·</span>
    <a href="https://www.npmjs.com/package/snapback-tui">npm</a>
  </footer>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-raised: #14171c;
    --border: #2d333b;
    --dim: #4a535e;
    --accent: #ffb454;
    --text: #e6e8eb;
    --text-dim: #8b949e;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    line-height: 1.6;
  }

  a {
    color: inherit;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  code {
    font-family: inherit;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.92em;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 980px;
    margin: 0 auto;
    padding: 28px 24px 0;
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .lockup img {
    border-radius: 6px;
    display: block;
  }

  .gh-link {
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
  .gh-link:hover {
    color: var(--text);
  }

  main {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    padding: 64px 0 80px;
  }

  .eyebrow {
    color: var(--dim);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    margin: 0 0 14px;
  }
  .eyebrow::before {
    content: "# ";
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.15;
    margin: 0 0 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .sub {
    color: var(--text-dim);
    max-width: 46ch;
    margin: 0 0 28px;
  }

  .prompt {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
  }
  .prompt-sigil {
    color: var(--dim);
  }
  .prompt-cmd {
    white-space: nowrap;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0.08; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .alt-install {
    color: var(--dim);
    font-size: 0.82rem;
    margin: 10px 0 30px;
  }

  .cta {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 8px;
    font-size: 0.95rem;
  }
  .cta:hover {
    opacity: 0.9;
  }

  .demo-frame {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .demo-titlebar {
    padding: 9px 14px;
    font-size: 0.78rem;
    color: var(--dim);
    border-bottom: 1px solid var(--border);
  }
  .demo-body {
    position: relative;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .demo-body img {
    width: 100%;
    display: block;
  }
  .demo-fallback {
    display: none;
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 20px;
    color: var(--dim);
    font-size: 0.78rem;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .demo-body.demo-missing img {
    display: none;
  }
  .demo-body.demo-missing .demo-fallback {
    display: flex;
  }

  .label {
    color: var(--dim);
    font-size: 0.85rem;
    margin: 0 0 18px;
  }

  .why {
    border-top: 1px solid var(--border);
    padding: 56px 0;
    max-width: 62ch;
  }
  .why p:not(.label) {
    color: var(--text-dim);
    margin: 0 0 16px;
  }

  .features {
    border-top: 1px solid var(--border);
    padding: 56px 0 72px;
  }

  .flags {
    margin: 0;
    display: grid;
    gap: 18px;
  }
  .flag-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .flag-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .flag-row dt {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .flag-row dd {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 28px 24px 40px;
    max-width: 980px;
    margin: 0 auto;
    color: var(--dim);
    font-size: 0.85rem;
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  footer a {
    color: var(--text-dim);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--text);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 40px 0 56px;
    }
    .flag-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
