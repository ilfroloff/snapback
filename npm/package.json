{
  "name": "snapback-tui",
  "version": "0.0.0",
  "description": "Terminal board for Claude Code: every session and background agent across your repos and worktrees, live. See which agent needs you, reply or stop it without leaving, and find any session by what was said.",
  "keywords": [
    "claude",
    "claude-code",
    "tui",
    "sessions",
    "resume",
    "cli",
    "agents",
    "background-agents",
    "worktree",
    "session-manager"
  ],
  "homepage": "https://github.com/ilfroloff/snapback#readme",
  "bugs": {
    "url": "https://github.com/ilfroloff/snapback/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilfroloff/snapback.git",
    "directory": "npm"
  },
  "license": "Apache-2.0",
  "author": "Illia Fralou",
  "type": "commonjs",
  "bin": {
    "snapback-tui": "cli.js"
  },
  "files": [
    "cli.js",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "preferUnplugged": true,
  "scripts": {
    "prepublishOnly": "node ./scripts/preflight.js"
  }
}
